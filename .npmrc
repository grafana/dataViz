# The real workspace and its .npmrc live in ./plugins. This root .npmrc only
# governs the no-op install that tooling occasionally performs at the repo root
# (e.g. grafana/plugin-actions/bundle-size, whose install step ignores its
# working-directory input). Keep lifecycle scripts disabled here too, matching
# plugins/.npmrc, to guard against supply-chain attacks via install scripts.
ignore-scripts=true
