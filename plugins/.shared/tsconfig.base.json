{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../.config/tsconfig.json",
  "exclude": [
    "node_modules",
    "webpack.config.ts",
    "webpack-monorepo.*",
    ".config",
    "tests",
    "**/*.test.ts",
    "**/*.test.tsx"
  ],
  "compilerOptions": {
    /* Monorepo module/target overrides on top of the vendored create-plugin base.
       The base extends @grafana/tsconfig (module esnext, target es2018,
       moduleResolution node, jsx react, lib es2022); we pin the values the
       bundler + project references expect instead. */
    "module": "ESNext",
    "target": "ES2017",
    "lib": ["ESNext", "DOM", "dom.iterable"],
    "moduleResolution": "Bundler",
    "jsx": "preserve",

    /* Project-reference / incremental build settings for the workspace.
       `declaration` is re-enabled here because the vendored base disables it,
       but composite projects require declaration emit. */
    "composite": true,
    "incremental": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationMap": false,
    "preserveWatchOutput": true,

    /* Monorepo-specific compiler options not covered by the base. */
    "isolatedModules": true,
    "allowJs": true,
    "allowArbitraryExtensions": true,
    "useDefineForClassFields": true,
    "verbatimModuleSyntax": true,
    "noErrorTruncation": true,
    "stripInternal": true,

    /* Extra strictness beyond @grafana/tsconfig's defaults. */
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true
  }
}
