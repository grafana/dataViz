{
  "name": "@plugins/marcusolsson-dynamictext-panel",
  "version": "6.3.0",
  "private": true,
  "type": "module",
  "description": "Data-driven text with Markdown and Handlebars support",
  "scripts": {
    "build": "webpack -c ./webpack.config.ts --env production --disable-interpret",
    "build:dev": "webpack -c ./webpack.config.ts --env development --disable-interpret",
    "dev": "webpack -w -c ./webpack.config.ts --env development --disable-interpret",
    "lint": "biome lint src",
    "lint:fix": "biome lint --write src",
    "format": "biome format src",
    "format:fix": "biome format --write src",
    "clean": "rm -rf dist",
    "test": "vitest",
    "test:ci": "vitest run",
    "build-types": "tsc --build --emitDeclarationOnly",
    "type-check": "tsc --noEmit"
  },
  "author": "Grafana Labs",
  "license": "Apache-2.0",
  "devDependencies": {
    "@swc/core": "^1.7.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@types/markdown-it": "^14.1.2",
    "@types/react": "^18.3",
    "@types/react-dom": "^18.2.11",
    "@types/semver": "^7.7.1",
    "copy-webpack-plugin": "^11.0.0",
    "css-loader": "^6.11.0",
    "monaco-editor": "0.34.1",
    "sass": "^1.56.1",
    "sass-loader": "^13.2.0",
    "style-loader": "^3.3.1",
    "swc-loader": "^0.2.6",
    "typescript": "^5.7.3",
    "vite": "^6.2.7",
    "vitest": "^2.0.0",
    "webpack": "^5.94.0",
    "webpack-cli": "^5.1.4",
    "webpack-merge": "^5.10.0"
  },
  "dependencies": {
    "@emotion/css": "^11.13.5",
    "@grafana/data": "12.4.2",
    "@grafana/i18n": "12.4.2",
    "@grafana/runtime": "12.4.2",
    "@grafana/scenes": "^7.4.2",
    "@grafana/schema": "12.4.2",
    "@grafana/ui": "12.4.2",
    "@hello-pangea/dnd": "^18.0.1",
    "dayjs": "^1.11.20",
    "handlebars": "^4.7.9",
    "helper-date": "^1.0.1",
    "highlight.js": "^11.11.1",
    "markdown-it": "^14.1.1",
    "react": "^18.3",
    "react-dom": "^18.3",
    "semver": "^7.7.4",
    "tslib": "^2.8.1",
    "uuid": "^14.0.0"
  }
}
