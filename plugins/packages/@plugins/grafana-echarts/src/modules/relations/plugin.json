{
  "$schema": "https://raw.githubusercontent.com/grafana/grafana/main/docs/sources/developers/plugins/plugin.schema.json",
  "type": "panel",
  "suggestions": true,
  "name": "ECharts Relations",
  "id": "grafana-relations-panel",
  "info": {
    "keywords": ["panel", "echarts", "graph", "node graph", "relations", "service map", "sankey", "chord"],
    "description": "Display service maps, flows, and other connected data as interactive graphs, Sankey diagrams, or chord diagrams. Each numeric field is one edge, identified by source/target labels or a name like A-->B, and its value weights the edge.",
    "author": {
      "name": "Grafana"
    },
    "logos": {
      "small": "img/logo.svg",
      "large": "img/logo.svg"
    },
    "links": [
      {
        "name": "documentation",
        "url": "https://grafana.com/grafana/plugins/grafana-relations-panel/"
      },
      {
        "name": "repository",
        "url": "https://github.com/grafana/dataViz"
      },
      {
        "name": "license",
        "url": "https://github.com/grafana/dataViz/blob/main/plugins/packages/@plugins/grafana-echarts/LICENSE"
      },
      {
        "name": "raise issue",
        "url": "https://github.com/grafana/dataViz/issues"
      }
    ],
    "screenshots": [
      {
        "name": "Graph, Sankey, chord, and time network presets",
        "path": "img/relations-presets.png"
      },
      {
        "name": "Time slider across graph, Sankey, and chord panels",
        "path": "img/relations-timeline.png"
      }
    ],
    "version": "%VERSION%",
    "updated": "%TODAY%"
  },
  "dependencies": {
    "grafanaDependency": ">=13.2.0-0",
    "plugins": []
  }
}
