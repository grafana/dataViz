# Runtime Grafana version for `npm run server` (docker compose).
# Pinned to 13.3.0 to match the plugin's @grafana/* dependencies.
# The base compose reads ${GRAFANA_VERSION:-13.0.2}; this overrides that default.
# `.config/` is managed by create-plugin, so change the version here, not there.
GRAFANA_VERSION=13.3.0
