{
  "name": "@plugins/grafana-echarts",
  "version": "0.0.1",
  "scripts": {
    "build": "webpack -c ./webpack.config.ts --env production",
    "build:dev": "webpack -c ./webpack.config.ts --env development",
    "build:analyze": "webpack -c ./webpack.config.ts --env production --env analyze",
    "build:relations": "webpack -c ./webpack.config.ts --env production --env standalone=relations",
    "build:renderer": "webpack -c ./webpack.renderer.config.ts && node scripts/renderer-manifest.mjs && node scripts/renderer-icons.mjs",
    "check:renderer": "node scripts/check-renderer-bundle.mjs",
    "check:contract-rules": "node scripts/check-contract-rules.mjs",
    "build:renderer-harness": "webpack -c ./webpack.renderer-harness.config.ts",
    "renderer:shots": "pnpm run build:renderer && pnpm run build:renderer-harness && RENDERER_SHOTS=${RENDERER_SHOTS:-all} playwright test -c playwright.renderer.config.ts screenshots",
    "test:renderer-sandbox": "pnpm run build:renderer && pnpm run build:renderer-harness && playwright test -c playwright.renderer.config.ts",
    "archive:relations": "node scripts/package-relations.mjs",
    "package:relations": "pnpm run build:relations && pnpm run archive:relations",
    "checks": "pnpm run type-check && pnpm run lint && pnpm run format && pnpm run test:ci",
    "dev": "webpack -w -c ./webpack.config.ts --env development --env withRelations",
    "test": "jest --watch --onlyChanged",
    "test:ci": "jest --ci --passWithNoTests --maxWorkers 4 && node --test 'scripts/*.test.mjs'",
    "type-check": "tsc --noEmit",
    "lint": "eslint --cache .",
    "lint:fix": "pnpm run lint --fix && prettier --write --list-different .",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "e2e": "playwright test",
    "e2e:debug": "playwright test --debug",
    "e2e:10x": "playwright test --repeat-each=10 --trace=off --retries=0 --max-failures=1",
    "bench:dataset": "node scripts/bench/dataset-vs-tuples.mjs",
    "bench:dataset-tooltip": "node scripts/bench/dataset-tooltip-probe.mjs",
    "bench:dirty-rect": "node scripts/bench/dirty-rect.mjs",
    "bench:force-resize": "node scripts/bench/force-resize.mjs",
    "bench:relations-refresh": "node scripts/bench/relations-refresh.mjs",
    "server": "COMPOSE_PROJECT_NAME=${GRAFANA_CONTAINER_NAME:-grafana-echarts-panel-${GRAFANA_PORT:-3020}} docker compose up --build",
    "server:relations": "COMPOSE_PROJECT_NAME=${GRAFANA_CONTAINER_NAME:-grafana-echarts-panel-relations-${GRAFANA_PORT:-4001}} docker compose -f docker-compose-relations.yaml up --build",
    "server:e2e": "pnpm run build:relations && pnpm run server:relations",
    "server:e2e:nightly": "pnpm run build:relations && export GRAFANA_IMAGE=grafana GRAFANA_VERSION=nightly GRAFANA_PORT=${GRAFANA_PORT:-4002} GF_FEATURE_TOGGLES_ENABLE=grafana.panelPluginTransformations && COMPOSE_PROJECT_NAME=grafana-echarts-panel-relations-$GRAFANA_PORT docker compose -f docker-compose-relations.yaml build --pull && pnpm run server:relations",
    "e2e:nightly": "GRAFANA_PORT=${GRAFANA_PORT:-4002} playwright test",
    "server:lgtm": "pnpm run build && COMPOSE_PROJECT_NAME=${GRAFANA_CONTAINER_NAME:-grafana-echarts-panel-lgtm-${GRAFANA_PORT:-3010}} docker compose -f docker-compose-lgtm.yaml up --build",
    "sign": "sign-plugin"
  },
  "author": "Grafana",
  "license": "Apache-2.0",
  "devDependencies": {
    "@grafana/eslint-config": "9.0.0",
    "@grafana/plugin-e2e": "3.15.4",
    "@grafana/sign-plugin": "3.2.2",
    "@grafana/tsconfig": "2.0.1",
    "@grafana/viz-contract": "1.2.0",
    "@playwright/test": "1.57.0",
    "@stylistic/eslint-plugin-ts": "4.4.1",
    "@swc/core": "1.15.0",
    "@swc/helpers": "0.5.0",
    "@swc/jest": "0.2.39",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/jest": "30.0.0",
    "@types/node": "24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/topojson-client": "3.1.5",
    "@typescript-eslint/eslint-plugin": "8.62.1",
    "@typescript-eslint/parser": "8.62.1",
    "copy-webpack-plugin": "14.0.0",
    "css-loader": "7.1.0",
    "eslint": "9.32.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsdoc": "63.0.10",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-webpack-plugin": "6.0.0",
    "fork-ts-checker-webpack-plugin": "9.1.0",
    "glob": "14.0.2",
    "identity-obj-proxy": "3.0.0",
    "imports-loader": "5.0.0",
    "jest": "30.4.2",
    "jest-canvas-mock": "2.5.2",
    "jest-canvas-mock-compare": "0.1.0",
    "jest-environment-jsdom": "30.4.1",
    "prettier": "3.9.6",
    "pretty-format": "30.4.1",
    "replace-in-file-webpack-plugin": "1.0.6",
    "sass": "1.89.0",
    "sass-loader": "17.0.0",
    "semver": "7.7.0",
    "style-loader": "4.0.0",
    "swc-loader": "0.2.0",
    "terser-webpack-plugin": "5.6.1",
    "topojson-server": "3.0.1",
    "topojson-simplify": "3.0.3",
    "ts-node": "10.9.2",
    "typescript": "5.9.2",
    "webpack": "5.108.4",
    "webpack-bundle-analyzer": "5.3.0",
    "webpack-cli": "6.0.0",
    "webpack-livereload-plugin": "3.0.2",
    "webpack-subresource-integrity": "5.1.0",
    "webpack-virtual-modules": "0.6.2"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@emotion/css": "11.10.6",
    "@grafana/data": "13.3.0",
    "@grafana/i18n": "13.3.0",
    "@grafana/runtime": "13.3.0",
    "@grafana/schema": "13.3.0",
    "@grafana/ui": "13.3.0",
    "echarts": "6.1.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "rxjs": "7.8.2",
    "topojson-client": "3.1.0"
  },
  "packageManager": "pnpm@11.21.0"
}
