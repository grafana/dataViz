{
  "name": "@plugins/grafana-canvas-panel",
  "version": "13.2.0",
  "private": true,
  "type": "module",
  "description": "Draw pictures with the Canvas visualization panel plugin, then paint by numbers with your Grafana metrics data!",
  "scripts": {
    "generate": "node scripts/generate-img-manifests.mjs",
    "build": "pnpm run generate && webpack -c ./webpack.config.ts --env production --disable-interpret",
    "build:dev": "pnpm run generate && webpack -c ./webpack.config.ts --env development --disable-interpret",
    "dev": "pnpm run generate && webpack -w -c ./webpack.config.ts --env development --disable-interpret",
    "lint": "biome lint src",
    "lint:fix": "biome lint --write src",
    "format": "biome format src",
    "format:fix": "biome format --write src",
    "clean": "rm -rf dist",
    "test": "vitest",
    "test:ci": "vitest run && pnpm run test:scripts",
    "test:scripts": "node --test scripts/*.test.mjs",
    "build-types": "tsc --build --emitDeclarationOnly",
    "type-check": "tsc --noEmit"
  },
  "author": "Grafana",
  "license": "AGPL-3.0-only",
  "devDependencies": {
    "@swc/core": "^1.7.0",
    "@types/lodash": "4.17.20",
    "@types/react": "^18.3",
    "@types/react-dom": "^18.2.11",
    "@types/react-resizable": "3.0.8",
    "@types/react-window": "1.8.8",
    "copy-webpack-plugin": "^11.0.0",
    "glob": "^11.1.0",
    "typescript": "^5.7.3",
    "vite": "^6.2.7",
    "vitest": "^2.0.0",
    "webpack": "^5.94.0",
    "webpack-cli": "^5.1.4",
    "webpack-merge": "^5.10.0"
  },
  "dependencies": {
    "@emotion/css": "11.10.6",
    "@emotion/react": "11.14.0",
    "@floating-ui/react": "0.27.19",
    "@grafana/data": "^13.1.0",
    "@grafana/e2e-selectors": "^13.1.0",
    "@grafana/i18n": "^13.1.0",
    "@grafana/runtime": "^13.1.0",
    "@grafana/schema": "^13.1.0",
    "@grafana/ui": "^13.1.0",
    "@rc-component/tree": "1.1.0",
    "@react-aria/dialog": "3.5.31",
    "@react-aria/focus": "3.21.2",
    "@react-aria/overlays": "3.30.0",
    "infinite-viewer": "^0.29.1",
    "lodash": "^4.17.21",
    "moveable": "0.53.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-draggable": "4.5.0",
    "react-inlinesvg": "4.3.0",
    "react-moveable": "0.56.0",
    "react-resizable": "3.0.5",
    "react-router-dom-v5-compat": "^6.30.4",
    "react-use": "^17.6.0",
    "react-virtualized-auto-sizer": "1.0.26",
    "react-window": "1.8.11",
    "rxjs": "^7.8.2",
    "selecto": "1.26.3",
    "tslib": "^2.6.0"
  }
}
