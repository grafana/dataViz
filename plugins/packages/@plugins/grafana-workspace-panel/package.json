{
  "name": "@plugins/grafana-workspace-panel",
  "version": "1.0.0",
  "private": true,
  "description": "Example Grafana panel plugin",
  "scripts": {
    "build": "webpack -c ./webpack.config.mjs --env production",
    "build:dev": "webpack -c ./webpack.config.mjs --env development",
    "dev": "webpack -w -c ./webpack.config.mjs --env development",
    "lint": "biome lint src",
    "lint:fix": "biome lint --write src",
    "format": "biome format src",
    "format:fix": "biome format --write src",
    "clean": "rm -rf dist",
    "test": "jest --watch --onlyChanged",
    "test:ci": "jest --passWithNoTests --maxWorkers 4",
    "build-types": "tsc --build --emitDeclarationOnly",
    "type-check": "tsc --noEmit"
  },
  "author": "Grafana Labs",
  "license": "Apache-2.0",
  "devDependencies": {
    "@swc/core": "^1.7.0",
    "@swc/jest": "^0.2.39",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/react": "^18.3",
    "@types/react-dom": "^18.2.11",
    "copy-webpack-plugin": "^11.0.0",
    "css-loader": "^6.11.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "sass": "^1.56.1",
    "sass-loader": "^13.2.0",
    "style-loader": "^3.3.1",
    "swc-loader": "^0.2.6",
    "typescript": "^5.7.3",
    "webpack": "^5.94.0",
    "webpack-cli": "^5.1.4",
    "webpack-merge": "^5.10.0"
  },
  "dependencies": {
    "@grafana/data": "^11.6.0",
    "@grafana/runtime": "^11.6.0",
    "@grafana/ui": "^11.6.0",
    "@shared/core": "workspace:*",
    "react": "^18.3",
    "react-dom": "^18.3"
  }
}
