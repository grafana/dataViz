{
  "name": "@plugins/grafana-echarts-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "ECharts app plugin bundling nested ECharts panel plugins",
  "scripts": {
    "build": "webpack -c ./webpack.config.ts --env production --disable-interpret",
    "build:dev": "webpack -c ./webpack.config.ts --env development --disable-interpret",
    "dev": "webpack -w -c ./webpack.config.ts --env development --disable-interpret",
    "lint": "biome lint src",
    "lint:fix": "biome lint --write src",
    "format": "biome format src",
    "format:fix": "biome format --write src",
    "clean": "rm -rf dist .cache",
    "test": "vitest",
    "test:ci": "vitest run && jest --ci --config jest.config.cjs",
    "test:canvas": "jest --config jest.config.cjs",
    "build-types": "tsc --build --emitDeclarationOnly",
    "type-check": "tsc --noEmit"
  },
  "author": "Grafana",
  "license": "Apache-2.0",
  "devDependencies": {
    "@swc/core": "^1.7.0",
    "@swc/jest": "0.2.39",
    "@testing-library/react": "16.3.2",
    "@types/node": "^22",
    "@types/react": "^18.3",
    "@types/react-dom": "^18.3",
    "copy-webpack-plugin": "^11.0.0",
    "css-loader": "^6.11.0",
    "identity-obj-proxy": "3.0.0",
    "jest": "30.4.2",
    "jest-canvas-mock": "2.5.2",
    "jest-canvas-mock-compare": "0.1.0",
    "jest-environment-jsdom": "30.4.1",
    "sass": "^1.56.1",
    "sass-loader": "^13.2.0",
    "style-loader": "^3.3.1",
    "swc-loader": "^0.2.6",
    "typescript": "^5.7.3",
    "vite": "^6.2.7",
    "vitest": "^2.0.0",
    "webpack": "^5.94.0",
    "webpack-cli": "^5.1.4",
    "webpack-merge": "^5.10.0"
  },
  "dependencies": {
    "@emotion/css": "11.10.6",
    "@grafana/data": "13.1.0",
    "@grafana/i18n": "13.1.0",
    "@grafana/runtime": "13.1.0",
    "@grafana/schema": "13.1.0",
    "@grafana/ui": "13.1.0",
    "echarts": "6.1.0",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  }
}
