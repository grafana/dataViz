{
  "name": "grafana-workspace",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@grafana/tsconfig": "2.0.1",
    "@swc/core": "1.15.0",
    "@vitejs/plugin-react": "5.1.0",
    "copy-webpack-plugin": "11.0.0",
    "eslint-webpack-plugin": "5.0.3",
    "fork-ts-checker-webpack-plugin": "9.1.0",
    "glob": "11.1.0",
    "imports-loader": "5.0.0",
    "jsdom": "25.0.1",
    "replace-in-file-webpack-plugin": "1.0.6",
    "swc-loader": "0.2.7",
    "terser-webpack-plugin": "5.6.1",
    "turbo": "2.9.14",
    "typescript": "5.9.3",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "2.1.9",
    "webpack": "5.104.1",
    "webpack-cli": "5.1.4",
    "webpack-livereload-plugin": "3.0.2",
    "webpack-merge": "5.10.0",
    "webpack-subresource-integrity": "5.1.0",
    "webpack-virtual-modules": "0.6.2"
  },
  "scripts": {
    "build": "turbo build",
    "build:dev": "turbo build:dev",
    "build-types": "turbo build-types",
    "type-check": "turbo type-check",
    "typecheck": "pnpm run type-check",
    "dev": "turbo dev",
    "test": "turbo test",
    "test:ci": "turbo test:ci",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "format": "turbo format",
    "format:fix": "turbo format:fix",
    "clean": "turbo clean",
    "check": "turbo format test:ci lint type-check",
    "update:config": "cd .config-reference && pnpm dlx @grafana/create-plugin@latest update --force",
    "sync:config": "node scripts/sync-config.mjs",
    "sync:workflows": "node scripts/sync-workflows.mjs",
    "plugin": "docker compose up",
    "server": "GRAFANA_VERSION=${GRAFANA_VERSION:-latest} GRAFANA_PORT=${GRAFANA_PORT:-3001} GRAFANA_CONTAINER_NAME=${GRAFANA_CONTAINER_NAME:-grafana-dataviz-${GRAFANA_PORT:-3001}} COMPOSE_PROJECT_NAME=${COMPOSE_PROJECT_NAME:-${GRAFANA_CONTAINER_NAME:-grafana-dataviz-${GRAFANA_PORT:-3001}}} docker compose -f docker-compose.grafana.yaml up"
  },
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22.18.0"
  }
}
