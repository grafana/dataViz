{
  "name": "grafana-workspace",
  "license": "Apache-2.0",
  "private": true,
  "version": "1.0.0",
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@swc/core": "1.15.0",
    "copy-webpack-plugin": "11.0.0",
    "pnpm": "11.21.0",
    "replace-in-file-webpack-plugin": "1.0.6",
    "swc-loader": "0.2.7",
    "turbo": "2.9.14",
    "typescript": "5.9.3",
    "webpack": "5.104.1",
    "webpack-cli": "5.1.4",
    "webpack-merge": "5.10.0"
  },
  "scripts": {
    "build": "turbo build",
    "build:dev": "turbo build:dev",
    "build-types": "turbo build-types",
    "type-check": "turbo type-check",
    "dev": "turbo dev",
    "test": "turbo test",
    "test:ci": "turbo test:ci",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "format": "turbo format",
    "format:fix": "turbo format:fix",
    "clean": "turbo clean",
    "check": "turbo format test:ci lint type-check",
    "plugin": "docker compose up",
    "server": "GRAFANA_VERSION=${GRAFANA_VERSION:-latest} GRAFANA_PORT=${GRAFANA_PORT:-3001} GRAFANA_CONTAINER_NAME=${GRAFANA_CONTAINER_NAME:-grafana-dataviz-${GRAFANA_PORT:-3001}} COMPOSE_PROJECT_NAME=${COMPOSE_PROJECT_NAME:-${GRAFANA_CONTAINER_NAME:-grafana-dataviz-${GRAFANA_PORT:-3001}}} docker compose -f docker-compose.grafana.yaml up"
  },
  "packageManager": "pnpm@11.21.0"
}
