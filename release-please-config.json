        "plugins/packages/@plugins/grafana-echarts/lgtm",
        "plugins/packages/@plugins/grafana-echarts/provisioning",
        "plugins/packages/@plugins/grafana-echarts/data-plane"
      ]
    },
    "plugins/packages/@plugins/grafana-echarts/src/modules/relations": {
