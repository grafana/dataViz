    { "section": "⚡ Performance Improvements", "type": "perf", "hidden": true },
    { "section": "✅ Tests", "type": "test", "hidden": true },
    { "section": "🏗️ Builds", "type": "build", "hidden": true },
    { "section": "🤖 Continuous Integrations", "type": "ci", "hidden": true },
    { "section": "🔧 Chores", "type": "chore", "hidden": true },
    { "section": "⏪ Reverts", "type": "revert", "hidden": true }
  ],
  "packages": {
    ".": {
      "release-type": "simple",
